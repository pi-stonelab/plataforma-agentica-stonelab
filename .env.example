CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Banco (docker-compose.yml e back-end). Use a mesma senha nas duas linhas.
POSTGRES_PASSWORD=
# Ex.: postgresql+psycopg://stonelab:<senha>@localhost:5432/stonelab
DATABASE_URL=

# Banco do mock (a Stone simulada). Vazio: SQLite local em dados_locais/mock.sqlite. Se apontar para
# outro banco (nunca o da plataforma), o gerador exige --permitir-banco-externo. Ex.: sqlite:///<caminho>
MOCK_DATABASE_URL=

# Modelo (Ollama atrás do Cloudflare Access). O endereço não fica no código.
LLM_URL=
LLM_MODELO=

# Modo terminal do agente (só teste local, com MODO_TERMINAL=1). Nível, área e carteira vêm do
# diretório do mock a partir do ID; no produto real, do login via back-end.
ID_USUARIO=
