CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Modelo (LLMClient do back-end). LLM_MODO=mock responde sem chamar o servidor.
LLM_MODO=ollama
OLLAMA_HOST=
OLLAMA_MODELO=qwen3.8:27b

# Banco (docker-compose.yml e back-end). Use a mesma senha nas duas linhas.
POSTGRES_PASSWORD=
# Ex.: postgresql+psycopg://stonelab:<senha>@localhost:5432/stonelab
DATABASE_URL=

# Login do back-end. JWT_SEGREDO assina o token: use um texto longo e aleatório, por exemplo a saída de
# python -c "import secrets; print(secrets.token_urlsafe(48))". Sem ele a API não sobe.
JWT_SEGREDO=
# Senha das contas da demo criadas por "python -m app.seed" (contas sintéticas, só para a demo).
SEED_SENHA_DEMO=

# Banco do mock (a Stone simulada). Vazio: SQLite local em dados_locais/mock.sqlite. Se apontar para
# outro banco (nunca o da plataforma), o gerador exige --permitir-banco-externo. Ex.: sqlite:///<caminho>
MOCK_DATABASE_URL=

# Modelo (Ollama atrás do Cloudflare Access). O endereço não fica no código.
LLM_URL=
LLM_MODELO=

# Modo terminal do agente (só teste local, com MODO_TERMINAL=1). Nível, área e carteira vêm do
# diretório do mock a partir do ID; no produto real, do login via back-end.
ID_USUARIO=

# Envio de e-mail (enviar_email), por SMTP. Sem EMAIL_SMTP_HOST o envio fica desligado e o agente não monta prévia.
# EMAIL_SMTP_SEGURANCA: starttls (padrão, porta 587), ssl (porta 465) ou nenhuma (só no localhost, como o
# Mailpit na porta 1025). Porta vazia usa a padrão. Usuário e senha vão juntos ou nenhum dos dois.
# EMAIL_DESTINO_TESTE manda todo e-mail para esse endereço, com [TESTE] no assunto: use o seu nos testes.
# Gmail: EMAIL_SMTP_HOST=smtp.gmail.com, usuário e remetente = o seu Gmail, senha = uma "senha de app" da conta.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORTA=
EMAIL_SMTP_SEGURANCA=
EMAIL_SMTP_USUARIO=
EMAIL_SMTP_SENHA=
EMAIL_REMETENTE=
EMAIL_DESTINO_TESTE=
