CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Modelo (LLMClient do back-end). LLM_MODO=mock responde sem chamar o servidor.
# O endereço e o modelo são LLM_URL e LLM_MODELO, mais abaixo (os mesmos do modo terminal).
LLM_MODO=ollama

# Banco (docker-compose.yml e back-end). Use a mesma senha nas duas linhas.
POSTGRES_PASSWORD=
# Ex.: postgresql+psycopg://stonelab:<senha>@localhost:5432/stonelab
DATABASE_URL=

# Banco do mock (a Stone simulada). Vazio: SQLite local em dados_locais/mock.sqlite. Se apontar para
# outro banco (nunca o da plataforma), o gerador exige --permitir-banco-externo. Ex.: sqlite:///<caminho>
MOCK_DATABASE_URL=
# Escrita das ferramentas que gravam no mock depois da confirmação (abrir chamado, acordo, reprocessar liquidação).
# Vazio com o SQLite local: grava no mesmo arquivo. Com o Postgres do mock: a URL do papel mock_escrita, ex.
# postgresql+psycopg://mock_escrita:<senha da escrita>@127.0.0.1:5433/stonelab_mock
MOCK_ESCRITA_DATABASE_URL=

# Modelo (Ollama atrás do Cloudflare Access). O endereço não fica no código.
# LLM_MODELO vazio usa qwen3.8:27b no back-end. Confira o nome com: cd backend && python -m app.llm_client
LLM_URL=
LLM_MODELO=

# Modo terminal do agente (só teste local, com MODO_TERMINAL=1). Nível, área e carteira vêm do
# diretório do mock a partir do ID; no produto real, do login via back-end.
ID_USUARIO=

# Envio de e-mail (enviar_email), por SMTP. Sem EMAIL_SMTP_HOST o envio fica desligado e o agente não monta prévia.
# EMAIL_SMTP_SEGURANCA: starttls (padrão, porta 587), ssl (porta 465) ou nenhuma (só no localhost, como o
# Mailpit na porta 1025). Porta vazia usa a padrão. Usuário e senha vão juntos ou nenhum dos dois.
# EMAIL_DESTINO_TESTE manda todo e-mail para esse endereço, com [TESTE] no assunto. OBRIGATÓRIO na demo: os
# contatos do mock são @lojistas.example e não existem, então sem ele a tela diz "Enviado." e ninguém recebe.
# Gmail: EMAIL_SMTP_HOST=smtp.gmail.com, usuário e remetente = o seu Gmail, senha = uma "senha de app" da conta.
# Sem conta de verdade (Mailpit, uma caixa de e-mail local): docker run -p 1025:1025 -p 8025:8025 axllent/mailpit,
# depois EMAIL_SMTP_HOST=localhost, EMAIL_SMTP_PORTA=1025, EMAIL_SMTP_SEGURANCA=nenhuma, sem usuário e senha;
# os e-mails aparecem em http://localhost:8025. Teste: MODO_TERMINAL=1 python -m ferramentas.integracoes testar email
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORTA=
EMAIL_SMTP_SEGURANCA=
EMAIL_SMTP_USUARIO=
EMAIL_SMTP_SENHA=
EMAIL_REMETENTE=
EMAIL_DESTINO_TESTE=

# APIs públicas (consultar_endereco_cep e consultar_cotacao_moeda). APIS_PUBLICAS_MODO: real (padrão), simulado
# (sem rede: 3 CEPs e cotações de exemplo, ilustrativas) ou desligado. As URLs vazias usam as oficiais
# (https://viacep.com.br e https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata). Teste:
# MODO_TERMINAL=1 python -m ferramentas.integracoes testar apis_publicas
APIS_PUBLICAS_MODO=
VIACEP_URL=
BCB_PTAX_URL=

# Chamados internos no Jira Cloud (consultar_chamado_jira, abrir_chamado_jira e comentar_chamado_jira).
# Conta de serviço da plataforma: JIRA_EMAIL e um token de API criado em id.atlassian.com (Segurança > Tokens de
# API). JIRA_URL é o site, como https://empresa.atlassian.net. JIRA_PROJETOS: chaves liberadas (KAN,PLAT);
# ler e abrir só nelas. JIRA_TIPOS: tipos que o agente pode abrir (Tarefa,Bug); o primeiro é o padrão.
# Preencher o JIRA_TOKEN liga; JIRA_MODO força real, simulado (chamados em memória) ou desligado.
# Teste: MODO_TERMINAL=1 python -m ferramentas.integracoes testar jira
JIRA_MODO=
JIRA_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJETOS=
JIRA_TIPOS=

# Mensagem num canal interno do Slack (enviar_mensagem_slack). SLACK_TOKEN: token de bot (xoxb-...) com o
# escopo chat:write, e o bot convidado em cada canal. SLACK_CANAIS: apelido:ID_do_canal separados por vírgula
# (financeiro:C0123ABCD,plantao:C0456EFGH); o agente só conhece o apelido. Preencher o SLACK_TOKEN liga;
# SLACK_MODO força real, simulado ou desligado. SLACK_URL fica vazia (só os testes usam).
# Teste: MODO_TERMINAL=1 python -m ferramentas.integracoes testar slack
SLACK_MODO=
SLACK_TOKEN=
SLACK_CANAIS=
SLACK_URL=

# Aviso num chat interno do Telegram (enviar_aviso_telegram). TELEGRAM_TOKEN: o token que o @BotFather entrega
# (123456789:AA...), com o bot adicionado a cada chat. TELEGRAM_CHATS: apelido:chat_id separados por vírgula
# (plantao:-1001234567890). Preencher o TELEGRAM_TOKEN liga; TELEGRAM_MODO força real, simulado ou desligado.
# TELEGRAM_URL fica vazia (só os testes usam). Teste: MODO_TERMINAL=1 python -m ferramentas.integracoes testar telegram
TELEGRAM_MODO=
TELEGRAM_TOKEN=
TELEGRAM_CHATS=
TELEGRAM_URL=

# Leitura da caixa de e-mail da plataforma por IMAP (buscar_emails): as respostas dos lojistas. Integração
# separada do envio. Gmail: ative o IMAP e use EMAIL_IMAP_HOST=imap.gmail.com, o e-mail da caixa e uma senha de
# app. EMAIL_IMAP_SEGURANCA: ssl (padrão, porta 993), starttls (143) ou nenhuma (só no localhost). Pasta vazia usa
# INBOX. Preencher o EMAIL_IMAP_HOST liga; EMAIL_LEITURA_MODO força real, simulado ou desligado.
# Teste: MODO_TERMINAL=1 python -m ferramentas.integracoes testar email_leitura
EMAIL_LEITURA_MODO=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORTA=
EMAIL_IMAP_SEGURANCA=
EMAIL_IMAP_USUARIO=
EMAIL_IMAP_SENHA=
EMAIL_IMAP_PASTA=

# Agenda, planilhas e documentos da conta de CADA pessoa (listar_eventos_agenda, criar_evento_agenda, buscar_arquivos,
# ler_planilha, adicionar_linha_planilha, criar_planilha e ler_documento). Cada funcionário liga a própria conta (OAuth2,
# na tela de integrações); aqui fica só o app da plataforma. Preencher o CLIENT_ID liga; o *_MODO força real, simulado
# (agenda e arquivos de exemplo, sem conta e sem rede) ou desligado. Com as duas ligadas, a pessoa escolhe qual usar.
# *_REDIRECT_URI: o endereço https da rota de retorno do back-end, igual ao cadastrado no app. As *_URL ficam vazias
# (só os testes usam). Passo a passo e o que conferir: ferramentas/integracoes/<google_workspace|microsoft_365>/README.md
# Teste do app (sem conta): MODO_TERMINAL=1 python -m ferramentas.integracoes testar google_workspace (ou microsoft_365)
# Google: app OAuth "aplicativo da Web" no Console do Google Cloud, com as APIs Calendar, Sheets, Docs e Drive ligadas.
GOOGLE_MODO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_URL=
# Microsoft: app registrado no Microsoft Entra ID (tipo Web). MICROSOFT_TENANT: o GUID do diretório ou o domínio da
# empresa (vazio: organizations). O segredo só fica vazio se o app foi registrado como cliente público.
MICROSOFT_MODO=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
MICROSOFT_REDIRECT_URI=
MICROSOFT_URL=
# Domínios que podem receber convite de evento (stone.com.br,filial.com.br). Vazio: ninguém. Vale para as duas contas.
ESCRITORIO_DOMINIOS=

# Anexos do chat (ler_arquivo_anexado e entregar_arquivo). ANEXOS_DIRETORIO: caminho ABSOLUTO de uma pasta onde a
# plataforma possa gravar, fora do repositório (os arquivos de cada pessoa ficam nela por 7 dias). Preencher liga;
# ANEXOS_MODO força real, simulado (na memória, com arquivos de exemplo) ou desligado.
# Teste: MODO_TERMINAL=1 python -m ferramentas.integracoes testar anexos
ANEXOS_MODO=
ANEXOS_DIRETORIO=

# Falhas simuladas (QA e demo): sistemas fora do ar, separados por vírgula. Ex.: MOCK_FALHAS=core,apis_publicas
# Sistemas: cadastro, core, cobranca, crm, diretorio, email, disputas, analitica, apis_publicas, jira, slack,
# telegram, email_leitura, google_workspace, microsoft_365 e anexos. A base analítica
# também aceita "dado desatualizado": MOCK_FALHAS=analitica:desatualizado
MOCK_FALHAS=
